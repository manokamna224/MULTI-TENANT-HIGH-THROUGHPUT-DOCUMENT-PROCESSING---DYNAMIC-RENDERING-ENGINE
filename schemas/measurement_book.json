{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docengine.internal/schemas/measurement_book.json",
  "title": "Measurement Book",
  "description": "Schema for civil engineering measurement book render payloads",
  "type": "object",
  "required": ["document_meta", "line_items", "summary"],
  "additionalProperties": false,

  "properties": {
    "document_meta": {
      "type": "object",
      "required": ["title", "contract_no", "contractor", "work_description", "date"],
      "additionalProperties": false,
      "properties": {
        "title":            { "type": "string", "maxLength": 200 },
        "contract_no":      { "type": "string", "maxLength": 50 },
        "contractor":       { "type": "string", "maxLength": 200 },
        "work_description": { "type": "string", "maxLength": 500 },
        "date":             { "type": "string", "format": "date" }
      }
    },

    "line_items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["index", "description", "unit", "quantity", "rate", "amount"],
        "additionalProperties": false,
        "properties": {
          "index":       { "type": "integer", "minimum": 0 },
          "description": { "type": "string",  "maxLength": 500 },
          "unit":        { "type": "string",  "maxLength": 20 },
          "quantity":    { "type": "string",  "pattern": "^\\d+(\\.\\d{1,6})?$" },
          "rate":        { "type": "string",  "pattern": "^\\d+(\\.\\d{1,2})?$" },
          "amount":      { "type": "string",  "pattern": "^\\d+(\\.\\d{1,2})?$" }
        }
      }
    },

    "summary": {
      "type": "object",
      "required": [
        "subtotal", "tax_rate_pct", "tax_amount", "grand_total",
        "contract_value", "previous_cumulative", "current_claim"
      ],
      "additionalProperties": false,
      "properties": {
        "subtotal":            { "type": "string", "pattern": "^\\d+(\\.\\d{1,2})?$" },
        "tax_rate_pct":        { "type": "number", "minimum": 0, "maximum": 100 },
        "tax_amount":          { "type": "string", "pattern": "^\\d+(\\.\\d{1,2})?$" },
        "grand_total":         { "type": "string", "pattern": "^\\d+(\\.\\d{1,2})?$" },
        "contract_value":      { "type": "string", "pattern": "^\\d+(\\.\\d{1,2})?$" },
        "previous_cumulative": { "type": "string", "pattern": "^\\d+(\\.\\d{1,2})?$" },
        "current_claim":       { "type": "string", "pattern": "^\\d+(\\.\\d{1,2})?$" }
      }
    }
  }
}
