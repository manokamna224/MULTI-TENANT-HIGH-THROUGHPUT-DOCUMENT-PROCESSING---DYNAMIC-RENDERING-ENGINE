# ─────────────────────────────────────────────────────────────────────────────
# DocEngine — environment variable reference
# Copy to .env and fill in real values. Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared infrastructure ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://docengine:devpassword@localhost:5432/docengine

# ── S3 / MinIO ────────────────────────────────────────────────────────────────
ARTIFACT_BUCKET=docengine-artifacts
S3_ENDPOINT=http://localhost:9000        # leave blank for real AWS S3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=ap-south-1

# ── API Gateway ───────────────────────────────────────────────────────────────
PORT=3000
UPSTREAM_URL=http://localhost:8080
JWT_SECRET=change-me-in-production-use-at-least-32-chars
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ── Ingestion Engine ──────────────────────────────────────────────────────────
# PORT=8080
GIN_MODE=debug                           # release in production

# ── Typst Render Worker ───────────────────────────────────────────────────────
CONSUMER_GROUP=typst-workers
CONSUMER_NAME=worker-1                   # must be unique per pod
WORKER_CONCURRENCY=4
TEMPLATE_DIR=./templates/typst
RUST_LOG=info

# ── Chromium Render Worker ────────────────────────────────────────────────────
# CONSUMER_GROUP=chromium-workers
MAX_JOBS_PER_WORKER=50
MAX_RSS_MB=250
# TEMPLATE_DIR=./templates/html

# ── Crypto Signing ────────────────────────────────────────────────────────────
SIGNING_KEY_SOURCE=pem                   # pem | pkcs12 | kms
SIGNING_CERT_PATH=./dev-certs/signing.crt
SIGNING_KEY_PATH=./dev-certs/signing.key
# SIGNING_P12_PATH=./dev-certs/signing.p12
# SIGNING_P12_PASS=devpassword
# KMS_KEY_ARN=arn:aws:kms:ap-south-1:123456789:key/...

# ── Artifact Storage / Webhook Dispatcher ────────────────────────────────────
PRESIGN_TTL_SEC=3600
LOG_LEVEL=info
