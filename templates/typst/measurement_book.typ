// Measurement Book Template — Typst
// ─────────────────────────────────────────────────────────────────────────────
// Data is injected via sys.inputs["data_file"] which points to a JSON file.
// Fields consumed:
//   document_meta  { title, contract_no, contractor, work_description, date }
//   line_items[]   { index, description, unit, quantity, rate, amount }
//   summary        { subtotal, tax_rate_pct, tax_amount, grand_total,
//                    contract_value, previous_cumulative, current_claim }
// ─────────────────────────────────────────────────────────────────────────────

#import "@preview/tablex:0.0.8": tablex, rowspanx, colspanx

// Load and parse the injected JSON payload
#let raw_data = sys.inputs.at("data_file", default: none)
#let data = if raw_data != none { json(raw_data) } else {
  panic("No data_file input provided to Typst template")
}

#let meta    = data.document_meta
#let items   = data.line_items
#let summary = data.summary

// ── Page setup ───────────────────────────────────────────────────────────────
#set page(
  paper: "a4",
  margin: (top: 20mm, bottom: 25mm, left: 20mm, right: 15mm),
  header: [
    #set text(size: 8pt, fill: luma(100))
    #grid(
      columns: (1fr, auto),
      [Contract No: #meta.contract_no],
      [Page #counter(page).display("1 of 1", both: true)]
    )
    #line(length: 100%, stroke: 0.5pt)
  ],
  footer: [
    #line(length: 100%, stroke: 0.5pt)
    #set text(size: 8pt, fill: luma(100))
    #align(center)[
      Generated by DocEngine · #datetime.today().display() · Document is digitally signed
    ]
  ]
)

#set text(font: "Linux Libertine", size: 9pt)
#set par(justify: false)

// ── Title block ──────────────────────────────────────────────────────────────
#align(center)[
  #text(weight: "bold", size: 13pt)[MEASUREMENT BOOK]
  #linebreak()
  #text(size: 10pt)[#meta.title]
]

#v(4mm)
#grid(
  columns: (auto, 1fr, auto, 1fr),
  gutter: 4mm,
  [*Contract No:*], [#meta.contract_no],
  [*Date:*],        [#meta.date],
  [*Contractor:*],  [#meta.contractor],
  [*Work:*],        [#meta.work_description],
)
#v(6mm)

// ── Line items table ─────────────────────────────────────────────────────────
// The table uses tablex for fine-grained cell merging and repeating headers.
#tablex(
  columns: (
    2em,   // S.No
    1fr,   // Description
    3em,   // Unit
    5em,   // Quantity
    6em,   // Rate (₹)
    7em,   // Amount (₹)
  ),
  repeat-header: true,
  // Header row
  fill: (col, row) => if row == 0 { luma(230) } else if calc.odd(row) { luma(248) } else { white },
  align: (col, _) => if col >= 3 { right } else { left },
  stroke: 0.5pt,
  [*S.No*], [*Description of Item*], [*Unit*], [*Quantity*], [*Rate (₹)*], [*Amount (₹)*],
  // Data rows
  ..items.map(item => (
    [#item.index],
    [#item.description],
    [#item.unit],
    [#str(item.quantity)],
    [#str(item.rate)],
    [#str(item.amount)],
  )).flatten()
)

#v(6mm)

// ── Summary block ────────────────────────────────────────────────────────────
#align(right)[
  #table(
    columns: (12em, 8em),
    stroke: none,
    fill: (_, row) => if calc.odd(row) { luma(248) } else { white },
    align: (col, _) => if col == 1 { right } else { left },
    [Sub-total],                [₹ #summary.subtotal],
    [GST @ #summary.tax_rate_pct%], [₹ #summary.tax_amount],
    table.hline(stroke: 1pt),
    [*Grand Total*],            [*₹ #summary.grand_total*],
    table.hline(stroke: 0.5pt),
    [Contract Value],           [₹ #summary.contract_value],
    [Previous Cumulative],      [₹ #summary.previous_cumulative],
    [*Current Claim*],          [*₹ #summary.current_claim*],
  )
]

#v(10mm)

// ── Signature block ──────────────────────────────────────────────────────────
#grid(
  columns: (1fr, 1fr, 1fr),
  gutter: 5mm,
  align(center)[
    #line(length: 80%, stroke: 0.5pt)
    Contractor
  ],
  align(center)[
    #line(length: 80%, stroke: 0.5pt)
    Junior Engineer
  ],
  align(center)[
    #line(length: 80%, stroke: 0.5pt)
    Executive Engineer
  ],
)
