{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docengine.internal/schemas/cumulative_billing.json",
  "title": "Cumulative Billing Statement",
  "type": "object",
  "required": ["document_meta", "line_items", "summary"],
  "additionalProperties": false,
  "properties": {
    "document_meta": {
      "type": "object",
      "required": ["title", "contract_no", "bill_no", "date"],
      "additionalProperties": false,
      "properties": {
        "title":       { "type": "string", "maxLength": 200 },
        "contract_no": { "type": "string", "maxLength": 50 },
        "bill_no":     { "type": "integer", "minimum": 1 },
        "date":        { "type": "string", "format": "date" }
      }
    },
    "line_items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["index", "description", "unit", "quantity", "rate", "amount"],
        "additionalProperties": false,
        "properties": {
          "index":       { "type": "integer", "minimum": 0 },
          "description": { "type": "string" },
          "unit":        { "type": "string" },
          "quantity":    { "type": "string", "pattern": "^\\d+(\\.\\d{1,6})?$" },
          "rate":        { "type": "string", "pattern": "^\\d+(\\.\\d{1,2})?$" },
          "amount":      { "type": "string", "pattern": "^\\d+(\\.\\d{1,2})?$" }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["subtotal","tax_rate_pct","tax_amount","grand_total","contract_value","previous_cumulative","current_claim"],
      "additionalProperties": false,
      "properties": {
        "subtotal":            { "type": "string" },
        "tax_rate_pct":        { "type": "number" },
        "tax_amount":          { "type": "string" },
        "grand_total":         { "type": "string" },
        "contract_value":      { "type": "string" },
        "previous_cumulative": { "type": "string" },
        "current_claim":       { "type": "string" }
      }
    }
  }
}
