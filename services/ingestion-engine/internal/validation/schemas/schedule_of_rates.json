{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docengine.internal/schemas/schedule_of_rates.json",
  "title": "Schedule of Rates",
  "type": "object",
  "required": ["document_meta", "sections"],
  "additionalProperties": false,
  "properties": {
    "document_meta": {
      "type": "object",
      "required": ["title", "financial_year"],
      "additionalProperties": false,
      "properties": {
        "title":          { "type": "string", "maxLength": 200 },
        "financial_year": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "items"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "maxLength": 200 },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["code", "description", "unit", "rate"],
              "additionalProperties": false,
              "properties": {
                "code":        { "type": "string", "maxLength": 20 },
                "description": { "type": "string", "maxLength": 500 },
                "unit":        { "type": "string", "maxLength": 20 },
                "rate":        { "type": "string", "pattern": "^\\d+(\\.\\d{1,2})?$" }
              }
            }
          }
        }
      }
    }
  }
}
