{
  "name": "artifact-storage",
  "version": "0.1.0",
  "description": "Webhook dispatcher and presigned URL generator",
  "main": "dist/index.js",
  "scripts": {
    "build":      "tsc",
    "start":      "node dist/index.js",
    "dev":        "ts-node src/index.ts",
    "typecheck":  "tsc --noEmit",
    "test":       "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ioredis":  "5.4.1",
    "aws-sdk":  "2.1691.0",
    "axios":    "1.7.7",
    "pg":       "8.13.0",
    "winston":  "3.14.2",
    "uuid":     "10.0.0"
  },
  "devDependencies": {
    "typescript":          "5.6.3",
    "@types/node":         "22.7.5",
    "@types/pg":           "8.11.10",
    "@types/uuid":         "10.0.0",
    "ts-node":             "10.9.2",
    "vitest":              "2.1.4",
    "@vitest/coverage-v8": "2.1.4"
  }
}
