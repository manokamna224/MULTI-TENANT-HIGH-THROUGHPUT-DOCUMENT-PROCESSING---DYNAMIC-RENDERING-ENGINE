{
  "name": "api-gateway",
  "version": "0.1.0",
  "description": "HMAC/JWT tenant authentication, rate limiting, and reverse proxy",
  "main": "dist/index.js",
  "scripts": {
    "build":      "tsc",
    "start":      "node dist/index.js",
    "dev":        "ts-node src/index.ts",
    "typecheck":  "tsc --noEmit",
    "test":       "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fastify":             "4.28.1",
    "@fastify/http-proxy": "9.5.0",
    "@fastify/rate-limit": "9.1.0",
    "ioredis":             "5.4.1",
    "jsonwebtoken":        "9.0.2",
    "pg":                  "8.13.0",
    "winston":             "3.14.2"
  },
  "devDependencies": {
    "typescript":          "5.6.3",
    "@types/node":         "22.7.5",
    "@types/jsonwebtoken": "9.0.7",
    "@types/pg":           "8.11.10",
    "ts-node":             "10.9.2",
    "vitest":              "2.1.4",
    "@vitest/coverage-v8": "2.1.4"
  }
}
